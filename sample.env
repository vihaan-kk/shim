# Copy to .env and fill in. Never commit .env.

# Nemotron 3.5 Lightning served by vLLM (OpenAI-compatible API)
VLLM_BASE_URL=http://localhost:8000/v1
MODEL_NAME=NVIDIA-Nemotron-3.5-Lightning-30B-A3B

# Local OctoPrint with the Virtual Printer (scripts/octoprint/start.sh)
OCTOPRINT_URL=http://localhost:5001
OCTOPRINT_API_KEY=replace-with-a-generated-key

# 1 = use tools/fakes instead of the real tools
FAKE_TOOLS=0
